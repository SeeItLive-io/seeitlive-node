{
  "name": "@seeitlive/sdk",
  "version": "0.1.0",
  "description": "Official SeeItLive SDK for Node.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" } },
  "scripts": { "build": "tsup src/index.ts --format cjs,esm --dts", "test": "vitest run" },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "keywords": ["seeitlive", "sdk", "video", "live", "api"],
  "devDependencies": { "@types/node": "^22.10.0", "tsup": "^8.5.1", "typescript": "^5.7.0", "vitest": "^3.2.6" },
  "overrides": { "esbuild": ">=0.28.1", "vite": ">=6.4.3" }
}
